// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

// Prisma 7: the `prisma-client` generator emits plain TypeScript into `output`.
// Connection URL lives in prisma.config.ts, not here (P1012 otherwise).
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  sessions      Session[]
  accounts      Account[]
  workflows     Workflow[]
  credentials   Credential[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

model Credential {
  id String @id @default(cuid())
  name String
  type String

  /// Envelope encryption (AF-M3-01/02): per-record AES-256-GCM ciphertext
  /// (Bytes), DEK wrapped by the KEK from CREDENTIAL_MASTER_KEY. No plaintext
  /// column and no read path — only `preview` (write-time fragment) is stored.
  ciphertext Bytes
  iv Bytes
  authTag Bytes
  wrappedDek Bytes
  keyVersion Int @default(1)
  preview String?
  oauthExpiresAt DateTime?
  refreshError String?
  lastUsedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  Node Node[]

  @@index([userId])
  @@index([type])
  @@index([oauthExpiresAt])
}

model Workflow {
  id String @id @default(cuid())
  name String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Secret token embedded in trigger webhook URLs to prove ownership (AF-A-01)
  webhookSecret String @unique @default(cuid())

  /// Optimistic concurrency counter — incremented on every saveGraph (AF-M1-03)
  revision Int @default(0)

  nodes Node[]
  connections Connection[]
  executions Execution[]

  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Node {
  id String @id @default(cuid())
  workflowId String
  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  name String
  type String
  typeVersion Int @default(1)
  disabled Boolean @default(false)
  notes String?
  position Json
  data Json @default("{}")

  credentialId String?
  credential Credential? @relation(fields: [credentialId], references: [id])

  outputConnections Connection[] @relation("FromNode")
  inputConnections Connection[] @relation("ToNode")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Connection {
  id String @id @default(cuid())
  workflowId String
  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  fromNodeId String
  fromNode Node @relation("FromNode", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNodeId String
  toNode Node @relation("ToNode", fields: [toNodeId], references: [id], onDelete: Cascade)

  fromOutput String @default("main")
  toInput String @default("main")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fromNodeId, toNodeId, fromOutput, toInput])
}

enum ExecutionStatus {
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
  TIMED_OUT
}

model Execution {
  id String @id @default(cuid())

  workflowId String
  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  status ExecutionStatus @default(RUNNING)

  /// What triggered this run: MANUAL, WEBHOOK, SCHEDULE, API, SUBWORKFLOW
  trigger String @default("MANUAL")
  /// PRODUCTION or TEST (in-editor test runs)
  mode String @default("PRODUCTION")
  /// Snapshot of the graph at run start — makes history immutable (P3)
  graphSnapshot Json @default("{}")
  /// Trigger input payload
  input Json?

  error String? @db.Text
  errorStack String? @db.Text

  startedAt DateTime @default(now())
  completedAt DateTime?
  durationMs Int?

  /// Aggregate counts rolled up from NodeExecution rows at finalize
  nodeCount Int @default(0)
  tokensIn Int @default(0)
  tokensOut Int @default(0)
  costUsd Float @default(0)

  inngestEventId String @unique

  output Json?

  nodeExecutions NodeExecution[]

  @@index([workflowId, startedAt(sort: Desc)])
  @@index([status])
}

enum NodeExecutionStatus {
  RUNNING
  SUCCESS
  FAILED
  SKIPPED
}

/// Per-node execution trace (AF-A-05). One row per node attempt within an
/// Execution; unreached nodes get SKIPPED rows so the full plan is visible.
model NodeExecution {
  id String @id @default(cuid())

  executionId String
  execution Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  nodeId String
  nodeName String
  nodeType String
  typeVersion Int @default(1)

  status NodeExecutionStatus @default(RUNNING)
  /// Zero-based Inngest function attempt that produced this row.
  attempt Int @default(0)
  /// Position of the node in the topological order, for stable rendering.
  order Int

  /// Node input — truncated above the IO cap (128 KB) with a marker
  input Json?
  /// Node output — truncated above the IO cap (128 KB) with a marker
  output Json?

  error String? @db.Text
  /// Why the node was skipped (branch not taken, upstream failed, cancelled)
  skipReason String?

  startedAt DateTime @default(now())
  finishedAt DateTime?
  durationMs Int?

  /// Per-node token and cost tracking (rolled up to Execution at finalize)
  tokensIn Int @default(0)
  tokensOut Int @default(0)
  costUsd Float @default(0)

  @@index([executionId, order])
  @@index([executionId, startedAt(sort: Desc)])
  @@index([status])
}
