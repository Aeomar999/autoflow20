// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum Plan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

model User {
  id               String            @id
  name             String
  email            String
  emailVerified    Boolean           @default(false)
  image            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt
  sessions         Session[]
  accounts         Account[]
  workflows        Workflow[]
  credentials      Credential[]
  members          Member[]
  auditLogs        AuditLog[]
  approvedRequests ApprovalRequest[]
  knowledgeSources KnowledgeSource[]
  apiKeys       ApiKey[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  // Better Auth 1.7 keys accounts by (issuer, accountId): "local:credential" for
  // password logins, "local:oauth:<provider>" for social ones. Every write of an
  // account row sends it, so the column is not optional.
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      Plan     @default(FREE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members          Member[]
  invitations      Invitation[]
  workspaces       Workspace[]
  workflows        Workflow[]
  credentials      Credential[]
  executions       Execution[]
  auditLogs        AuditLog[]
  approvalRequests ApprovalRequest[]
  aiResponseCache  AiResponseCache[]
  notifications    Notification[]
  apiKeys          ApiKey[]

  @@map("organization")
}

model Member {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role         @default(EDITOR)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, userId])
  @@map("member")
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           Role         @default(EDITOR)
  token          String       @unique @default(cuid())
  expiresAt      DateTime
  invitedById    String?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@map("invitation")
}

model Workspace {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, slug])
  @@map("workspace")
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorId        String?
  actor          User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorType      String       @default("USER")
  action         String
  resourceType   String
  resourceId     String
  before         Json?
  after          Json?
  ip             String?
  userAgent      String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([resourceType, resourceId])
  @@map("audit_log")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  TIMED_OUT
}

model ApprovalRequest {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflowId     String
  workflow       Workflow       @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  executionId    String
  execution      Execution      @relation(fields: [executionId], references: [id], onDelete: Cascade)
  nodeId         String
  nodeName       String
  status         ApprovalStatus @default(PENDING)
  prompt         String?
  comment        String?
  timeoutAt      DateTime
  respondedById  String?
  respondedBy    User?          @relation(fields: [respondedById], references: [id], onDelete: SetNull)
  respondedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([organizationId, status])
  @@map("approval_request")
}

model Credential {
  id   String @id @default(cuid())
  name String
  type String

  ciphertext     Bytes
  iv             Bytes
  authTag        Bytes
  wrappedDek     Bytes
  keyVersion     Int       @default(1)
  preview        String?
  oauthExpiresAt DateTime?
  refreshError   String?
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  Node Node[]

  @@index([userId])
  @@index([organizationId])
  @@index([type])
  @@index([oauthExpiresAt])
}

// AF-M8-01: Public REST API keys. Only the hash and an 8-char lookup prefix
// are stored - the full `af_...` secret is shown once at creation and never
// persisted. `scopes` is a comma-joined string set (open set - never an enum).
model ApiKey {
  id             String   @id @default(cuid())
  name           String
  prefix         String   @unique
  hash           String   @unique
  scopes         String   @default("")
  createdAt      DateTime @default(now())
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  revokedAt      DateTime?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdById    String?
  createdBy      User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@map("api_key")
}

model Workflow {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  webhookSecret String @unique @default(cuid())
  revision      Int    @default(0)

  activeVersionId String?
  activeVersion   WorkflowVersion? @relation("ActiveVersion", fields: [activeVersionId], references: [id], onDelete: SetNull)

  /**
   * AF-M7-08 per-workflow notification preferences. Failure defaults ON
   * because a run that broke is the thing people need told about; success
   * defaults OFF because a workflow on a five-minute cron would otherwise
   * generate 288 notifications a day and the centre would be worthless.
   */
  notifyOnFailure Boolean @default(true)
  notifyOnSuccess Boolean @default(false)

  nodes            Node[]
  connections      Connection[]
  executions       Execution[]
  versions         WorkflowVersion[] @relation("WorkflowVersions")
  approvalRequests ApprovalRequest[]
  notifications    Notification[]

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
}

model Node {
  id         String   @id @default(cuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  name        String
  type        String
  typeVersion Int     @default(1)
  disabled    Boolean @default(false)
  notes       String?
  position    Json
  data        Json    @default("{}")

  credentialId String?
  credential   Credential? @relation(fields: [credentialId], references: [id])

  outputConnections Connection[] @relation("FromNode")
  inputConnections  Connection[] @relation("ToNode")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Connection {
  id         String   @id @default(cuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  fromNodeId String
  fromNode   Node   @relation("FromNode", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNodeId   String
  toNode     Node   @relation("ToNode", fields: [toNodeId], references: [id], onDelete: Cascade)

  fromOutput String @default("main")
  toInput    String @default("main")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fromNodeId, toNodeId, fromOutput, toInput])
}

enum ExecutionStatus {
  RUNNING
  SUCCESS
  FAILED
  QUOTA_EXCEEDED
  CANCELLED
  TIMED_OUT
}

model Execution {
  id String @id @default(cuid())

  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  status ExecutionStatus @default(RUNNING)

  trigger       String @default("MANUAL")
  mode          String @default("PRODUCTION")
  graphSnapshot Json   @default("{}")
  input         Json?

  workflowVersionId String?
  workflowVersion   WorkflowVersion? @relation(fields: [workflowVersionId], references: [id], onDelete: SetNull)

  error      String? @db.Text
  errorStack String? @db.Text

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  durationMs  Int?

  nodeCount Int     @default(0)
  tokensIn  Int     @default(0)
  tokensOut Int     @default(0)
  costUsd   Decimal @default(0) @db.Decimal(12, 6)

  inngestEventId String @unique

  output Json?

  nodeExecutions   NodeExecution[]
  approvalRequests ApprovalRequest[]

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([workflowId, startedAt(sort: Desc)])
  @@index([organizationId])
  @@index([status])
  /// AF-M8-01: caller-supplied idempotency key deduping POST /run retries.
  /// Postgres treats NULLs as distinct in unique indexes, so rows created
  /// without an idempotency key are unaffected; rows sharing (workflowId,
  /// idempotencyKey) collide as intended.
  idempotencyKey String?
  @@unique([workflowId, idempotencyKey])
}

enum NodeExecutionStatus {
  RUNNING
  SUCCESS
  FAILED
  SKIPPED
}

model NodeExecution {
  id String @id @default(cuid())

  executionId String
  execution   Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  nodeId      String
  nodeName    String
  nodeType    String
  typeVersion Int    @default(1)

  status  NodeExecutionStatus @default(RUNNING)
  attempt Int                 @default(0)
  order   Int

  input  Json?
  output Json?

  error      String? @db.Text
  skipReason String?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  durationMs Int?

  tokensIn  Int     @default(0)
  tokensOut Int     @default(0)
  costUsd   Decimal @default(0) @db.Decimal(12, 6)

  /// `provider:model` that served this node, when it made an AI call. NULL for
  /// every non-AI node. Cost-per-model reporting groups on this (AF-M5-08).
  model String?

  /// Response-cache outcome (AF-M5-07). NULL means the node had no cache
  /// configured, so it belongs in neither half of the hit rate; false is a
  /// real miss, true a real hit. A hit records zero tokens and zero cost —
  /// nothing was purchased.
  cacheHit Boolean?

  @@index([executionId, order])
  @@index([executionId, startedAt(sort: Desc)])
  @@index([status])
  @@index([model, startedAt(sort: Desc)])
}

model WorkflowVersion {
  id String @id @default(cuid())

  workflowId String
  workflow   Workflow @relation("WorkflowVersions", fields: [workflowId], references: [id], onDelete: Cascade)

  version          Int
  workflowRevision Int

  graphSnapshot Json

  createdAt DateTime @default(now())

  activeFor  Workflow[]  @relation("ActiveVersion")
  executions Execution[]

  @@unique([workflowId, version])
  @@index([workflowId])
}

model KnowledgeSource {
  id           String           @id @default(cuid())
  name         String
  type         String           @default("FILE") // FILE | URL | TEXT
  mimeType     String?
  sizeBytes    Int?
  url          String?
  status       String           @default("PENDING") // PENDING | PROCESSING | EMBEDDED | ERROR
  errorMessage String?          @db.Text
  revision     Int              @default(0)
  chunkCount   Int              @default(0)
  tokenCount   Int              @default(0)
  credentialId String?
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks       KnowledgeChunk[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([userId])
  @@index([status])
}

model KnowledgeChunk {
  id         String                       @id @default(cuid())
  sourceId   String
  source     KnowledgeSource              @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  chunkIndex Int
  content    String                       @db.Text
  tokens     Int                          @default(0)
  revision   Int                          @default(0)
  embedding  Unsupported("vector(1536)")?
  createdAt  DateTime                     @default(now())
  updatedAt  DateTime                     @updatedAt

  @@index([sourceId, chunkIndex])
}

/// Workspace-scoped AI response cache (AF-M5-07).
///
/// One row per (organization, request fingerprint). `cacheKey` is a sha256 of
/// the canonical request envelope — node type, model chain, prompts, and the
/// call parameters that change an answer — so two different workspaces never
/// share an entry even when their prompts are identical.
///
/// Entries are read only while `expiresAt` is in the future; the daily sweep
/// (`sweepAiResponseCache`) deletes the expired ones. `hitCount` × `costUsd`
/// is the spend the cache avoided, which is what the hit-rate report shows.
model AiResponseCache {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  cacheKey String
  nodeType String
  /// `provider:model` that produced the cached response.
  model    String

  /// `{ value: <node result> }` — wrapped so non-object results stay valid JSON.
  response Json

  tokensIn  Int     @default(0)
  tokensOut Int     @default(0)
  costUsd   Decimal @default(0) @db.Decimal(12, 6)

  hitCount  Int       @default(0)
  createdAt DateTime  @default(now())
  lastHitAt DateTime?
  expiresAt DateTime

  @@unique([organizationId, cacheKey])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([expiresAt])
}

/// Tenant-agnostic workflow templates (AF-M7-01).
///
/// Templates are product content, not workspace data: no foreign key to a
/// workspace, and no user/org scoping on reads — every authenticated user
/// sees the same gallery. `graph` stores the React Flow graph ({ nodes, edges })
/// a workspace gets a fresh copy of when it installs; the installer rewrites
/// every node id to a fresh cuid and strips credential-bound data fields so an
/// install starts from unbound placeholders the user fills in Credentials.
model Template {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  description     String   @db.Text
  category        String
  tags            String[]
  graph           Json
  featured        Boolean  @default(false)
  isActive        Boolean  @default(true)
  nodeCount       Int      @default(0)
  credentialCount Int      @default(0)
  author          String   @default("AutoFlow")
  version         String   @default("1")
  installs        Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category, isActive])
}

/**
 * AF-M7-08 notification kinds. Open to extension, but each value must have a
 * producer — a type nothing writes is a promise the UI cannot keep.
 */
enum NotificationType {
  EXECUTION_FAILED
  EXECUTION_SUCCEEDED
  APPROVAL_REQUESTED
  CREDENTIAL_EXPIRING
  SYSTEM
}

/**
 * In-app notification (AF-M7-08). Tenant-scoped: there is no per-user
 * addressing in v1 — a notification belongs to the workspace and everyone who
 * can see the workspace sees it, which matches how executions and approvals
 * already work.
 */
model Notification {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           NotificationType
  title          String
  message        String           @db.Text

  /**
   * Where clicking it goes. Nullable for notices with no destination.
   */
  href String?

  /**
   * Null until read. A timestamp rather than a bool: when is worth keeping.
   */
  readAt DateTime?

  /**
   * Idempotency key, unique across the table. The runner tail can be replayed
   * by Inngest and a cron can fire twice on a redeploy; writing through
   * `skipDuplicates` on this key makes a retry a no-op instead of a duplicate
   * row. Composed from the logical event, never from a timestamp.
   */
  dedupeKey String @unique

  workflowId String?
  workflow   Workflow? @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  /**
   * Plain columns, not relations: they exist to build `href` and to let a
   * caller correlate. Keeping them FK-free means a pruned execution or a
   * deleted credential leaves the notification history intact rather than
   * silently erasing what was announced.
   */
  executionId  String?
  credentialId String?

  createdAt DateTime @default(now())

  /**
   * The centre's only read path: this org's rows, newest first.
   */
  @@index([organizationId, createdAt(sort: Desc)])
  /**
   * The bell's unread count.
   */
  @@index([organizationId, readAt])
}
