# Committed, dashboard-independent env for Vercel production builds.
# ---------------------------------------------------------------------------
# Vercel loads this file from the repo during `next build`, so these
# non-sensitive public values never need to be set in the Vercel dashboard.
#
# ONLY non-secret values go here (public base URLs, public slugs). Secrets
# (POLAR_ACCESS_TOKEN, POLAR_WEBHOOK_SECRET, DATABASE_URL, BETTER_AUTH_SECRET,
# CREDENTIAL_MASTER_KEY, social client secrets, Resend key) MUST stay in the
# Vercel dashboard - never commit them. See .env.example for the full list.

# Public base URL for the deployed site. MUST stay public: read at runtime in
# the browser by the stripe/google-form trigger dialogs (src/features/triggers/
# components/*/dialog.tsx) to build user-facing webhook URLs. A private name
# would make the value `undefined` in the browser and both dialogs would fall
# back to http://localhost:3000.
NEXT_PUBLIC_APP_URL="https://autoflow20.vercel.app"

# Public Pro slug shown in the two client checkout calls (app-sidebar.tsx,
# upgrade-modal.tsx call authClient.checkout({ slug })). Not a secret.
NEXT_PUBLIC_POLAR_PRODUCT_SLUG="pro"

# Post-checkout redirect needs no env var: src/lib/auth.ts passes a relative
# successUrl that the Polar plugin resolves against the request's own host.
