{
  "name": "HR Lifecycle - Phase 1: Recruitment",
  "nodes": [
    {
      "parameters": {
        "formTitle": "Job Application",
        "formDescription": "Apply for an open role. Upload your resume as a PDF and we will get back to you quickly.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Full Name",
              "fieldName": "Full Name",
              "requiredField": true
            },
            {
              "fieldLabel": "Email",
              "fieldType": "email",
              "fieldName": "Email",
              "requiredField": true
            },
            {
              "fieldLabel": "Position Applying For",
              "fieldName": "Position",
              "requiredField": true
            },
            {
              "fieldLabel": "Resume (PDF)",
              "fieldType": "file",
              "fieldName": "Resume",
              "multipleFiles": false,
              "acceptFileTypes": ".pdf",
              "requiredField": true
            }
          ]
        },
        "options": {
          "buttonLabel": "Submit Application",
          "path": "job-application",
          "respondWithOptions": {
            "values": {
              "formSubmittedText": "Thank you for applying! We are reviewing your application and will be in touch shortly."
            }
          }
        }
      },
      "id": "1432e704-02bb-4d84-b56a-952b5b664d60",
      "name": "Job Application Form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.6,
      "position": [0, 96],
      "webhookId": "e2f020aa-a470-4e9c-a184-8dca22029ab2"
    },
    {
      "parameters": {
        "operation": "pdf",
        "binaryPropertyName": "Resume",
        "options": {
          "joinPages": true
        }
      },
      "id": "4f34af6c-1bb1-46d2-86af-1e079b9cadec",
      "name": "Extract Resume Text",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1.1,
      "position": [224, 96]
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini",
          "cachedResultName": "gpt-4o-mini"
        },
        "responses": {
          "values": [
            {
              "role": "system",
              "content": "You are an expert technical recruiter. Evaluate the candidate resume against the role they applied for. Be fair and objective. Return a qualification decision, a score from 0 to 100, and a short justification. Treat a score of 70 or above as qualified."
            },
            {
              "content": "=Position applied for: {{ $('Job Application Form').item.json.Position }}\n\nCandidate name: {{ $('Job Application Form').item.json['Full Name'] }}\n\nResume text:\n{{ $json.text }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {
          "maxTokens": 800,
          "textFormat": {
            "textOptions": {
              "type": "json_schema",
              "name": "resume_screening",
              "schema": "{\"type\":\"object\",\"additionalProperties\":false,\"properties\":{\"qualified\":{\"type\":\"boolean\",\"description\":\"True if the candidate should advance to an interview\"},\"score\":{\"type\":\"number\",\"description\":\"Fit score from 0 to 100\"},\"summary\":{\"type\":\"string\",\"description\":\"One or two sentence summary of the candidate fit\"}},\"required\":[\"qualified\",\"score\",\"summary\"]}",
              "strict": true
            }
          },
          "temperature": 0.2
        }
      },
      "id": "430f5d24-dbd6-4e09-a779-12739eb5ef9b",
      "name": "AI Resume Screening",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [384, 528],
      "credentials": {
        "openAiApi": {
          "id": null,
          "name": "Gateway credits",
          "__aiGatewayManaged": true
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "qualified-check",
              "leftValue": "={{ $json.output[0].content[0].text.qualified }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "4e11df2c-6b35-47a4-add1-fdbb5c1c0d25",
