      "typeVersion": 3.5,
      "position": [896, 0]
    },
    {
      "parameters": {
        "sendTo": "={{ $('Job Application Form').item.json.Email }}",
        "subject": "=Your application for {{ $('Job Application Form').item.json.Position }} - let's schedule an interview",
        "message": "=Hi {{ $('Job Application Form').item.json['Full Name'] }},<br><br>Thank you for applying for the <b>{{ $('Job Application Form').item.json.Position }}</b> role. We were impressed with your background and would love to meet you.<br><br>Please book a time that works for you using the link below:<br><a href=\"{{ $json.bookingLink }}\">Schedule your interview</a><br><br>Looking forward to speaking with you!<br><br>Best regards,<br>The Recruiting Team",
        "options": {}
      },
      "id": "4debfccc-1196-445c-b30f-016b1f9b95e8",
      "name": "Send Interview Booking Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [1120, 0],
      "webhookId": "5ad70db1-3547-4b46-b41e-b0b6cc6e984e"
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "list",
          "value": "",
          "cachedResultName": "Select recruiting channel"
        },
        "text": "=:white_check_mark: *Qualified candidate* for *{{ $('Job Application Form').item.json.Position }}*\n*Name:* {{ $('Job Application Form').item.json['Full Name'] }}\n*Email:* {{ $('Job Application Form').item.json.Email }}\n*Score:* {{ $('AI Resume Screening').item.json.output[0].content[0].text.score }}/100\n*Summary:* {{ $('AI Resume Screening').item.json.output[0].content[0].text.summary }}\nAn interview booking link has been emailed to the candidate.",
        "otherOptions": {}
      },
      "id": "6d101120-f2d0-43ac-aecc-65e22f6e8ed6",
      "name": "Notify Recruiting - Qualified",
