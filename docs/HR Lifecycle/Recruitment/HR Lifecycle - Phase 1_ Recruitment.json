    },
    {
      "parameters": {
        "sendTo": "={{ $('Job Application Form').item.json.Email }}",
        "subject": "=Update on your application for {{ $('Job Application Form').item.json.Position }}",
        "message": "=Hi {{ $('Job Application Form').item.json['Full Name'] }},<br><br>Thank you for taking the time to apply for the <b>{{ $('Job Application Form').item.json.Position }}</b> role and for your interest in our company.<br><br>After careful review, we have decided not to move forward with your application at this time. We truly appreciate your effort and encourage you to apply for future openings that match your experience.<br><br>We wish you the very best in your job search.<br><br>Kind regards,<br>The Recruiting Team",
        "options": {}
      },
