# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Sentry Config File
.env.sentry-build-plugin

# product source material (PRDs, research papers, decks) — lives outside the repo
/Documents
/Papers

.tmp-*.log
.tmp-*.mjs

# local dev artifacts
/dev.log
/mprocs.log
/screens/
/apply_migration.js
/check_migrations.js
