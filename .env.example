# ============================================================================
# AutoFlow (nodebase) — environment template
#
# Usage:  cp .env.example .env   then fill in real values.
# NEVER commit `.env` — only this example carries names + dummy values.
#
# Every variable below was verified against actual code reads (2026-08-22).
# Required vars are validated at boot by src/lib/env.ts (AF-M0-08): the app
# refuses to start with a single readable error if one is missing or malformed.
# ============================================================================

# ----------------------------------------------------------------------------
# REQUIRED — core runtime
# ----------------------------------------------------------------------------

# Postgres connection string used by Prisma (prisma/schema.prisma:14).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nodebase?schema=public"

# Better Auth session signing secret (library convention; required in prod).
# Generate: openssl rand -base64 32   (or any string >= 32 chars)
BETTER_AUTH_SECRET="replace-me-with-a-32-char-minimum-random-secret"

# Base URL Better Auth uses to build callbacks/redirects.
# Must match NEXT_PUBLIC_APP_URL in dev.
BETTER_AUTH_URL="http://localhost:3000"

# LEGACY (optional, AF-M3-02+): Cryptr key read only by the one-time data
# converter scripts/migrate-credentials.ts (decrypt pre-vault rows).
# The runtime vault uses CREDENTIAL_MASTER_KEY below. Set only to convert an
# existing database created before AF-M3-02. Generate: openssl rand -hex 32
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Credential vault master key (AF-M3-01): 32 bytes, base64-encoded. KEK for
# envelope encryption of the credential vault (src/lib/crypto.ts). REQUIRED at
# boot - the app refuses to start without a valid key.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# The dummy value below is public and worthless - never promote it (or reuse a
# dev value) in production.
CREDENTIAL_MASTER_KEY="MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY="

# Public base URL shown in trigger dialogs when they render webhook URLs
# (stripe/google-form trigger dialogs fall back to http://localhost:3000).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ----------------------------------------------------------------------------
# OPTIONAL — social login providers (src/lib/auth.ts)
# Code casts these to string; sign-in buttons fail at request time if unset.
# ----------------------------------------------------------------------------

GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ----------------------------------------------------------------------------
# OPTIONAL — Polar billing (src/lib/polar.ts, src/lib/auth.ts)
# Without these, checkout/portal endpoints fail; signup itself still works.
# ----------------------------------------------------------------------------

# Polar access token from dashboard.polar.sh settings.
POLAR_ACCESS_TOKEN="polar_dummy_token"

# Redirect target after successful checkout (must be an absolute URL).
# The plugin substitutes {CHECKOUT_ID} into this URL if present.
POLAR_SUCCESS_URL="http://localhost:3000/workflows/billing/success"

# Pro plan product (AF-M0-03, read in src/lib/env.ts + src/lib/auth.ts).
# POLAR_PRODUCT_ID is your account-specific Polar product UUID; when unset
# the checkout product list stays empty (billing unconfigured) and the app
# still boots. The slug defaults to "pro" when both vars below are unset.
POLAR_PRODUCT_ID=""
POLAR_PRODUCT_SLUG="pro"
NEXT_PUBLIC_POLAR_PRODUCT_SLUG="pro"

# ----------------------------------------------------------------------------
# OPTIONAL — Inngest production keys
# Not referenced directly in code; the Inngest SDK reads these by convention
# when serving /api/inngest outside local dev mode (`npm run inngest:dev`
# works without them). Required in production deployments.
# ----------------------------------------------------------------------------

INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# Workflow engine retry count (AF-A-07). Same value in dev and production;
# override locally (0-20) if you intentionally want fewer/more attempts.
# ENGINE_RETRIES=3

# ----------------------------------------------------------------------------
# DEV TOOLING — local scripts (package.json)
# ----------------------------------------------------------------------------

# Your reserved ngrok domain, used by `npm run ngrok:dev` to expose webhooks.
# Leave empty unless testing public webhook ingress locally.
NGROK_URL=""

# Test-only Postgres used by the vitest integration suites
# (tests/integration/**). `npm run test:db:up` creates it on port 5433
# (pgvector/pgvector:pg16). Suites TRUNCATE the whole schema before every test,
# so NEVER point this at a shared or dev database.
# See docs/engineering/testing_strategy.md §4.
TEST_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/autoflow_test"

# ----------------------------------------------------------------------------
# FUTURE — not read by any code path yet (listed per tasks.md AF-A-01 / M0-08)
# ----------------------------------------------------------------------------

# Stripe webhook signing secret (AF-A-01). REQUIRED for Stripe triggers:
# the webhook route rejects unsigned requests and returns 500 if unset.
# Copy the signing secret from your Stripe Dashboard webhook endpoint.
STRIPE_WEBHOOK_SECRET="whsec_dummy"

# NOTE: each workflow also has a per-workflow `webhookSecret` (Prisma
# migration 20260822030000) appended to trigger URLs by the trigger dialogs.

# Build-time token for Sentry source-map upload (@sentry/webpack-plugin reads
# it automatically during `next build`; also see .env.sentry-build-plugin in
# .gitignore). Runtime DSNs are currently hardcoded in sentry.*.config.ts —
# externalizing them is audit defect D9.
SENTRY_AUTH_TOKEN=""
