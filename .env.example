# ============================================================================
# AutoFlow (nodebase) — environment template
#
# Usage:  cp .env.example .env   then fill in real values.
# NEVER commit `.env` — only this example carries names + dummy values.
#
# Every variable below was verified against actual code reads (2026-08-22).
# Required vars are validated at boot by src/lib/env.ts (AF-M0-08): the app
# refuses to start with a single readable error if one is missing or malformed.
# ============================================================================

# ----------------------------------------------------------------------------
# REQUIRED — core runtime
# ----------------------------------------------------------------------------

# Postgres connection string used by Prisma (prisma/schema.prisma:14).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nodebase?schema=public"

# Better Auth session signing secret (library convention; required in prod).
# Generate: openssl rand -base64 32   (or any string >= 32 chars)
BETTER_AUTH_SECRET="replace-me-with-a-32-char-minimum-random-secret"

# Base URL Better Auth uses to build callbacks/redirects.
# Must match NEXT_PUBLIC_APP_URL in dev.
BETTER_AUTH_URL="http://localhost:3000"

# LEGACY (optional, AF-M3-02+): Cryptr key read only by the one-time data
# converter scripts/migrate-credentials.ts (decrypt pre-vault rows).
# The runtime vault uses CREDENTIAL_MASTER_KEY below. Set only to convert an
# existing database created before AF-M3-02. Generate: openssl rand -hex 32
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Credential vault master key (AF-M3-01): 32 bytes, base64-encoded. KEK for
# envelope encryption of the credential vault (src/lib/crypto.ts). REQUIRED at
# boot - the app refuses to start without a valid key.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# The dummy value below is public and worthless - never promote it (or reuse a
# dev value) in production.
CREDENTIAL_MASTER_KEY="MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY="

# Public base URL shown in trigger dialogs when they render webhook URLs
# (stripe/google-form trigger dialogs fall back to http://localhost:3000).
#
# MUST STAY PUBLIC (`NEXT_PUBLIC_` prefix). This value is read at runtime in
# the browser by two "use client" components — stripe-trigger/dialog.tsx and
# google-form-trigger/dialog.tsx — that build the user-facing webhook URL to
# paste into Stripe/Google Forms. Removing the prefix bakes the reference
# server-side, the value becomes `undefined` in the browser, and both dialogs
# silently fall back to http://localhost:3000 (a regression into the localhost
# bug class this platform guards against). The value is a non-sensitive public
# base URL (your own site's domain), so Vercel's "remove the public prefix"
# warning is a false positive — dismiss it. It is also consumed server-side by
# src/lib/auth.ts and src/lib/auth-origins.ts as a trusted origin.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ----------------------------------------------------------------------------
# OPTIONAL — social login providers (src/lib/auth.ts)
# Code casts these to string; sign-in buttons fail at request time if unset.
# ----------------------------------------------------------------------------

GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ----------------------------------------------------------------------------
# OPTIONAL — workflow OAuth connectors (AF-M10-04)
#
# These are the client credentials for the OAuth apps a *workflow* connects to,
# registered in src/features/credentials/server/oauth-providers.ts. They are
# separate from the sign-in providers above: connecting a repo integration must
# not widen what the login button asks for, so GitHub appears in both blocks
# with different client ids.
#
# Each pair is independent. A provider whose id/secret is unset answers its
# /api/oauth/<type>/connect route with 501 and the rest of the app is
# unaffected — you only need the ones your automations use.
#
# Redirect URI to register with every provider:
#   <NEXT_PUBLIC_APP_URL>/api/oauth/<credential-type>/callback
# e.g. http://localhost:3000/api/oauth/intuit.oauth2/callback
# ----------------------------------------------------------------------------

# QuickBooks Online (developer.intuit.com). The company id (realmId) and the
# sandbox/production choice are captured at connect time, not configured here.
# NOTE: Intuit rotates the refresh token on every exchange — the old one dies
# immediately. Nothing to configure; stated because it surprises people.
INTUIT_CLIENT_ID=""
INTUIT_CLIENT_SECRET=""
# Webhook verifier token from the Intuit app dashboard (Webhooks tab).
# Required for /api/webhooks/quickbooks: without it every notification is
# refused, because a webhook endpoint that cannot verify must never fail open.
INTUIT_WEBHOOK_VERIFIER_TOKEN=""

# GitHub OAuth app for workflow nodes (scopes: repo, read:org).
# Distinct from GITHUB_CLIENT_ID/SECRET above, which is the sign-in app.
GITHUB_OAUTH_CLIENT_ID=""
GITHUB_OAUTH_CLIENT_SECRET=""

# Atlassian / Jira Cloud (developer.atlassian.com). `offline_access` is in the
# requested scope set — without it Atlassian issues no refresh token. The
# site's cloudId is fetched during connect.
ATLASSIAN_CLIENT_ID=""
ATLASSIAN_CLIENT_SECRET=""

# Notion public integration (notion.so/my-integrations). Notion has no scopes;
# access is whatever pages the user picks on the consent screen.
NOTION_CLIENT_ID=""
NOTION_CLIENT_SECRET=""

# Shopify app (partners.shopify.com). Connect with ?shop=<store>.myshopify.com
# — the authorize and token endpoints live on the merchant's own domain.
SHOPIFY_CLIENT_ID=""
SHOPIFY_CLIENT_SECRET=""

# LinkedIn app (linkedin.com/developers). Posting needs the `w_member_social`
# product enabled on the app, not just the scope.
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# X / Twitter API v2 (developer.x.com). OAuth 2.0 with PKCE. Write access is
# NOT on the free tier — a token that authorizes fine will still 403 on a post.
X_CLIENT_ID=""
X_CLIENT_SECRET=""

# ----------------------------------------------------------------------------
# OPTIONAL — file storage for binary payloads (AF-M10-06, ADR-0025)
#
# Where the bytes behind a FileRef live. Nodes that move a PDF, an image or a
# video pass a reference through the run context and the bytes go here.
#
# Selection is BY CONFIGURATION, NOT BY NODE_ENV: set the bucket and its
# credentials and the S3 backend is used; leave them empty and files go to the
# local filesystem. That is deliberate — a production deploy that forgot the
# bucket would otherwise write to a container filesystem that vanishes on the
# next deploy, and nobody finds out until a user opens yesterday's run. A
# bucket with no credentials refuses to boot in production rather than falling
# back.
#
# Works with any S3-compatible store: AWS S3, Cloudflare R2, MinIO, Backblaze.
# ----------------------------------------------------------------------------

BLOB_S3_BUCKET=""
BLOB_S3_ACCESS_KEY_ID=""
BLOB_S3_SECRET_ACCESS_KEY=""
# "auto" for R2; a real region for AWS.
BLOB_S3_REGION="auto"
# Required for R2/MinIO/B2; leave empty for AWS S3.
BLOB_S3_ENDPOINT=""
# R2 and MinIO need path-style addressing; AWS does not.
BLOB_S3_FORCE_PATH_STYLE=""

# Where the local backend writes when S3 is not configured. Relative paths are
# resolved from the process working directory. Add it to .gitignore.
BLOB_LOCAL_ROOT=".blobstore"

# ----------------------------------------------------------------------------
# OPTIONAL — transactional auth email (src/lib/email.ts, AF-M8-04)
# Delivered via Resend. Without these the app still boots and unaffected flows
# keep working (same pattern as Polar billing), but password reset and email
# verification FAIL LOUDLY when they need to send an email - never silently.
# ----------------------------------------------------------------------------

# Resend API key from https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"

# Verified sender (domain must be added in Resend). Defaults to
# "AutoFlow <onboarding@resend.dev>" (Resend's test sender) when unset.
RESEND_FROM_EMAIL="AutoFlow <noreply@yourdomain.com>"

# ----------------------------------------------------------------------------
# OPTIONAL — Polar billing (src/lib/polar.ts, src/lib/auth.ts)
# Without these, checkout/portal endpoints fail; signup itself still works.
# ----------------------------------------------------------------------------

# Polar access token from dashboard.polar.sh settings.
POLAR_ACCESS_TOKEN="polar_dummy_token"

# Post-checkout redirect is NOT configured by env var. The checkout plugin in
# src/lib/auth.ts passes a relative successUrl ("/workflows/billing/success")
# that it resolves against the request's own host, so production redirects to
# production and localhost to localhost with no per-environment value to get
# wrong (this removed the old POLAR_SUCCESS_URL, which a stale absolute value
# pointed at http://localhost:3000 and broke prod checkout redirects).

# Pro plan product (AF-M0-03, read in src/lib/env.ts + src/lib/auth.ts).
# POLAR_PRODUCT_ID is your account-specific Polar product UUID; when unset
# the checkout product list stays empty (billing unconfigured) and the app
# still boots. The slug defaults to "pro" when both vars below are unset.
POLAR_PRODUCT_ID=""
POLAR_PRODUCT_SLUG="pro"
NEXT_PUBLIC_POLAR_PRODUCT_SLUG="pro"

# Subscription webhooks -> Organization.plan (AF-M8-23).
#
# POLAR_WEBHOOK_SECRET is the signing secret Polar shows when you create the
# endpoint at https://<your-domain>/api/auth/polar/webhooks. Subscribe it to
# subscription.active, .updated, .canceled and .revoked. When it is unset the
# plugin rejects every delivery with 400, so billing is inert rather than
# unauthenticated - paying customers stay on FREE limits.
POLAR_WEBHOOK_SECRET=""

# Which product grants which plan. Account-specific UUIDs, so they must come
# from here rather than the source. An id that arrives on a webhook without a
# mapping grants nothing and logs an error. POLAR_PRODUCT_ID above doubles as
# the Pro product when POLAR_PRODUCT_ID_PRO is unset, so a single-product
# install needs no extra configuration.
POLAR_PRODUCT_ID_STARTER=""
POLAR_PRODUCT_ID_PRO=""
POLAR_PRODUCT_ID_ENTERPRISE=""

# ----------------------------------------------------------------------------
# OPTIONAL — Inngest production keys
# Not referenced directly in code; the Inngest SDK reads these by convention
# when serving /api/inngest outside local dev mode (`npm run inngest:dev`
# works without them). Required in production deployments.
# ----------------------------------------------------------------------------

INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# Workflow engine retry count (AF-A-07). Same value in dev and production;
# override locally (0-20) if you intentionally want fewer/more attempts.
# ENGINE_RETRIES=3

# ----------------------------------------------------------------------------
# DEV TOOLING — local scripts (package.json)
# ----------------------------------------------------------------------------

# Your reserved ngrok domain, used by `npm run ngrok:dev` to expose webhooks.
# Leave empty unless testing public webhook ingress locally.
NGROK_URL=""

# Test-only Postgres used by the vitest integration suites
# (tests/integration/**). `npm run test:db:up` creates it on port 5433
# (pgvector/pgvector:pg16). Suites TRUNCATE the whole schema before every test,
# so NEVER point this at a shared or dev database.
# See docs/engineering/testing_strategy.md §4.
TEST_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/autoflow_test"

# AF-M9-02 — TEST-ONLY. Setting this lets the workflow HTTP nodes reach
# loopback (127.0.0.1 / ::1) so the engine's acceptance suite can run a
# loopback webhook/target server. It widens ONLY loopback — metadata, private,
# and CGNAT ranges stay blocked. FORBIDDEN in production: the boot refuses to
# start if this is set with NODE_ENV=production. Never enable outside local
# test runs.
ALLOW_LOOPBACK_EGRESS=""


# ----------------------------------------------------------------------------
# FUTURE — not read by any code path yet (listed per tasks.md AF-A-01 / M0-08)
# ----------------------------------------------------------------------------

# Stripe webhook signing secret (AF-A-01). REQUIRED for Stripe triggers:
# the webhook route rejects unsigned requests and returns 500 if unset.
# Copy the signing secret from your Stripe Dashboard webhook endpoint.
STRIPE_WEBHOOK_SECRET="whsec_dummy"

# NOTE: each workflow also has a per-workflow `webhookSecret` (Prisma
# migration 20260822030000) appended to trigger URLs by the trigger dialogs.

# Build-time token for Sentry source-map upload (@sentry/webpack-plugin reads
# it automatically during `next build`; also see .env.sentry-build-plugin in
# .gitignore). Runtime DSNs are currently hardcoded in sentry.*.config.ts —
# externalizing them is audit defect D9.
SENTRY_AUTH_TOKEN=""

# ---------------------------------------------------------------------------
# Legal entity and support (AF-M8-10)
#
# The Terms, Privacy Policy, and DPA at /terms, /privacy, and /dpa REFUSE to
# render their body until every value below is set. That is deliberate: a
# policy showing a placeholder company name reads as a real policy to a user
# and as negligence to a regulator, so an unconfigured deployment shows what is
# missing instead of publishing blanks.
#
# Setting these does NOT make the documents publishable. They are engineer
# drafts and must be reviewed by a qualified lawyer first — see
# docs/operations/beta_launch_checklist.md §4.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_LEGAL_ENTITY_NAME=""
NEXT_PUBLIC_LEGAL_JURISDICTION=""
NEXT_PUBLIC_LEGAL_ADDRESS=""
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=""
# Optional — falls back to NEXT_PUBLIC_LEGAL_CONTACT_EMAIL when unset.
NEXT_PUBLIC_LEGAL_PRIVACY_EMAIL=""
# ISO date shown as the policies' effective date, e.g. 2026-09-14.
NEXT_PUBLIC_LEGAL_EFFECTIVE_DATE=""

# Support inbox shown on the support page and in the policies.
NEXT_PUBLIC_SUPPORT_EMAIL=""
